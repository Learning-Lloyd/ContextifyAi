APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost/ContextifyAI/client/dist

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Configure these to the exact browser origin(s) that host the frontend.
# Production origins must use HTTPS; multiple origins are comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only to the trusted reverse-proxy IPs/CIDRs when TLS terminates before Laravel.
TRUSTED_PROXIES=

# Admin accounts are never seeded unless explicitly enabled with a strong password.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Contextify Administrator

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider (Gemini is the default; OpenRouter remains an explicit optional provider)
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# At most two retries after the first attempt; temporary 429/5xx/timeouts use bounded backoff.
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=300
AI_RETRY_MAX_DELAY_MS=2000
AI_RETRY_MAX_WAIT_SECONDS=5
CONTEXTIFY_PRIORITY_MODEL_URL=http://127.0.0.1:8010/predict-priority
CONTEXTIFY_PRIORITY_MODEL_TIMEOUT=4
AI_TIMEOUT=30
AI_USER_PER_MINUTE=5
AI_GLOBAL_PER_MINUTE=5
