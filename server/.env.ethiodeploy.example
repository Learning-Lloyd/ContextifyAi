# Reference only: enter these values in EthioDeploy's environment settings.
# Do not upload this file as .env or place credentials in source control.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<project>.ethiodeploy.app
FRONTEND_URL=https://<project>.ethiodeploy.app
APP_KEY=

DB_CONNECTION=mysql
# EthioDeploy injects DATABASE_URL. Set DB_URL only when intentionally overriding it.
DB_URL=

# EthioDeploy's Laravel guide recommends trusting the platform proxy with '*'.
# Use this only for the EthioDeploy deployment; replace with exact proxy IPs/CIDRs if provided.
TRUSTED_PROXIES=*

CORS_ALLOWED_ORIGINS=https://<project>.ethiodeploy.app
SESSION_SECURE_COOKIE=true

AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Vite values are public and must be set in build-time environment settings.
VITE_API_URL=/api
VITE_BASE_PATH=/
